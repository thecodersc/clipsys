# Copy this file to ".env" (same folder) and fill it in. Never share or commit .env.

# Required for YouTube uploads.
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (type: Desktop app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional: Telegram alerts and the manual-post queue (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: full paths, only if ffmpeg/ffprobe are not on PATH
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# Optional: transcription device. auto = GPU when available, otherwise CPU.
# WHISPER_DEVICE=cpu
